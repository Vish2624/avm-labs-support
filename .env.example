# Supabase project connection (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used for all data reads/writes
# (test catalog, pricing, imports) so the browser never talks to Postgres directly.
SUPABASE_SERVICE_ROLE_KEY=
# Optional, server-only Gemini keys (free: https://aistudio.google.com/apikey).
# One Google account per key, so each has its own daily quota; a feature
# whose key is missing or out of quota borrows the others (lib/ai/gemini.ts).
#   GEMINI_API_KEY           - "Paste text or image": pasted messages
#   GEMINI_API_KEY_IMAGE     - "Paste text or image": prescription photos
#   GEMINI_API_KEY_SEARCH    - finding similar tests when one asked about isn't available
#   GEMINI_API_KEY_ASSISTANT - the Support Assistant
# With no keys at all, everything uses the free built-in / in-browser readers.
GEMINI_API_KEY=
GEMINI_API_KEY_IMAGE=
GEMINI_API_KEY_SEARCH=
GEMINI_API_KEY_ASSISTANT=
